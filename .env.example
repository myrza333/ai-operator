# Куда фронт отправляет запросы к API. Вшивается в сборку (next build), поэтому
# в проде задай до сборки.
# Локально: напрямую на бэкенд.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Прод на Vercel + Render (разные домены): ходим через прокси Next на тот же домен
#   NEXT_PUBLIC_API_URL=/api
#   API_PROXY_TARGET=https://имя-сервиса.onrender.com
# Так cookie остаётся first-party и работает в Safari/Firefox.
# API_PROXY_TARGET=
